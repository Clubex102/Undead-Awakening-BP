{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "udaw:pillager_cannon",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 12 : 0"
      },
      "minecraft:collision_box": { "width": 2.0, "height": 2.6 },
      "minecraft:type_family": { "family": [ "pillager", "monster", "illager", "mob", "pillager_cannon" ] },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "deals_damage": "no",
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "pillager_bullet"
              }
            }
          },
          {
            "deals_damage": "no",
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "pillager_cannon_bullet"
              }
            }
          }
        ]
      },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:health": { "value": 30, "max": 30 },
      "minecraft:knockback_resistance": { "value": 0.6, "max": 0.6 },
      "minecraft:movement": { "value": 0.12 },
      "minecraft:navigation.walk": { "can_path_over_water": true },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:nameable": {},
      "minecraft:despawn": { "despawn_from_distance": {} },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:follow_range": { "value": 64 },
      "minecraft:behavior.ranged_attack": {
        "priority": 4,
        "attack_interval_min": 6.5,
        "attack_interval_max": 8.5,
        "attack_radius": 20
      },
      "minecraft:shooter": {
        "def": "udaw:pillagercannonbullet"
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": {
          "filters": { "test": "is_family", "subject": "other", "operator": "!=", "value": "illager" },
          "max_dist": 64
        }
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 16.0,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "is_family", "subject": "other", "value": "villager" },
                { "test": "is_family", "subject": "other", "value": "zombie" },
                { "test": "is_family", "subject": "other", "value": "irongolem" },
                { "test": "is_family", "subject": "other", "value": "wandering_trader" }
              ]
            },
            "max_dist": 100
          }
        ]
      },
      "minecraft:behavior.random_stroll": { "priority": 8, "speed_multiplier": 0.8 },
      "minecraft:behavior.look_at_player": { "priority": 9, "look_distance": 8 },
      "minecraft:behavior.random_look_around": { "priority": 10 }
    },
    "events": {}
  }
}
