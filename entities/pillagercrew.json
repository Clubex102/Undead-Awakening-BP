{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "udaw:pillager_crew",
      "spawn_category": "monster",
      "is_spawnable": false,
      "is_summonable": true
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5 : 0"
      },
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:type_family": { "family": [ "pillager", "monster", "illager", "mob", "pillager_crew" ] },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "deals_damage": "no",
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "pillager_bullet"
              }
            }
          },
          {
            "deals_damage": "no",
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "pillager_cannon_bullet"
              }
            }
          }
        ]
      },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:health": { "value": 24, "max": 24 },
      "minecraft:movement": { "value": 0.35 },
      "minecraft:navigation.walk": { "can_path_over_water": true },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:nameable": {},
      "minecraft:equipment": { "table": "loot_tables/entities/pillager_crew_gear.json" },
      "minecraft:despawn": { "despawn_from_distance": {} },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:follow_range": { "value": 48 },
      "minecraft:home": { "restriction_radius": 8 },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1,
        "entity_types": {
          "filters": { "test": "is_family", "subject": "other", "operator": "!=", "value": "illager" },
          "max_dist": 48
        }
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 16.0,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "zombie" }
              ]
            },
            "max_dist": 20
          }
        ]
      },
      "minecraft:attack": { "damage": 7 },
      "minecraft:behavior.melee_box_attack": {
        "priority": 4,
        "track_target": true
      },
      "minecraft:behavior.move_towards_home": {
        "priority": 6,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.random_stroll": { "priority": 8, "speed_multiplier": 0.8 },
      "minecraft:behavior.look_at_player": { "priority": 9, "look_distance": 8 },
      "minecraft:behavior.random_look_around": { "priority": 10 }
    },
    "events": {}
  }
}
