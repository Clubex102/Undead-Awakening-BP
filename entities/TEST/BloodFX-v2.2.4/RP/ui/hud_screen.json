{
  "namespace": "hud",

  "bloodfx_image": {
    "type": "image",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ "112%", "112%" ],
    "keep_ratio": false,
    "fill": true,
    "layer": 100,
    "$bloodfx_state": "$actionbar_text",
    "$bloodfx_texture|default": "ndarcraft/transparent",
    "$bloodfx_match|default": "§0BFX_OFF",
    "texture": "$bloodfx_texture",
    "visible": "($bloodfx_state = $bloodfx_match)"
  },

  "bloodfx_overlay": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ "100%", "100%" ],
    "layer": 100,
    "controls": [
      { "low_1@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/low_1", "$bloodfx_match": "§0BFX_LOW_1" } },
      { "low_2@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/low_2", "$bloodfx_match": "§0BFX_LOW_2" } },
      { "low_3@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/low_3", "$bloodfx_match": "§0BFX_LOW_3" } },
      { "low_4@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/low_4", "$bloodfx_match": "§0BFX_LOW_4" } },
      { "low_5@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/low_5", "$bloodfx_match": "§0BFX_LOW_5" } },
      { "medium_1@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/medium_1", "$bloodfx_match": "§0BFX_MEDIUM_1" } },
      { "medium_2@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/medium_2", "$bloodfx_match": "§0BFX_MEDIUM_2" } },
      { "medium_3@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/medium_3", "$bloodfx_match": "§0BFX_MEDIUM_3" } },
      { "medium_4@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/medium_4", "$bloodfx_match": "§0BFX_MEDIUM_4" } },
      { "medium_5@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/medium_5", "$bloodfx_match": "§0BFX_MEDIUM_5" } },
      { "high_1@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/high_1", "$bloodfx_match": "§0BFX_HIGH_1" } },
      { "high_2@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/high_2", "$bloodfx_match": "§0BFX_HIGH_2" } },
      { "high_3@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/high_3", "$bloodfx_match": "§0BFX_HIGH_3" } },
      { "high_4@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/high_4", "$bloodfx_match": "§0BFX_HIGH_4" } },
      { "high_5@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/high_5", "$bloodfx_match": "§0BFX_HIGH_5" } },
      { "hit_1@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/hit_1", "$bloodfx_match": "§0BFX_HIT_1" } },
      { "hit_2@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/hit_2", "$bloodfx_match": "§0BFX_HIT_2" } },
      { "hit_3@hud.bloodfx_image": { "$bloodfx_texture": "ndarcraft/hit_3", "$bloodfx_match": "§0BFX_HIT_3" } }
    ]
  },

  "bloodfx_overlay_factory": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ "100%", "100%" ],
    "factory": {
      "name": "hud_actionbar_text_factory",
      "control_ids": {
        "hud_actionbar_text": "bloodfx_overlay@hud.bloodfx_overlay"
      }
    }
  },

  "hud_actionbar_text": {
    "$bloodfx_actionbar": "$actionbar_text",
    "visible": "(not (($bloodfx_actionbar = '§0BFX_OFF') or ($bloodfx_actionbar = '§0BFX_LOW_1') or ($bloodfx_actionbar = '§0BFX_LOW_2') or ($bloodfx_actionbar = '§0BFX_LOW_3') or ($bloodfx_actionbar = '§0BFX_LOW_4') or ($bloodfx_actionbar = '§0BFX_LOW_5') or ($bloodfx_actionbar = '§0BFX_MEDIUM_1') or ($bloodfx_actionbar = '§0BFX_MEDIUM_2') or ($bloodfx_actionbar = '§0BFX_MEDIUM_3') or ($bloodfx_actionbar = '§0BFX_MEDIUM_4') or ($bloodfx_actionbar = '§0BFX_MEDIUM_5') or ($bloodfx_actionbar = '§0BFX_HIGH_1') or ($bloodfx_actionbar = '§0BFX_HIGH_2') or ($bloodfx_actionbar = '§0BFX_HIGH_3') or ($bloodfx_actionbar = '§0BFX_HIGH_4') or ($bloodfx_actionbar = '§0BFX_HIGH_5') or ($bloodfx_actionbar = '§0BFX_HIT_1') or ($bloodfx_actionbar = '§0BFX_HIT_2') or ($bloodfx_actionbar = '§0BFX_HIT_3')))"
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "bloodfx_overlay_factory@hud.bloodfx_overlay_factory": {}
        }
      }
    ]
  }
}
